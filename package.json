{
  "name": "pickleball-media-organizer",
  "version": "0.1.0",
  "description": "Electron app to organize pickleball videos and photos.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "NODE_ENV=development concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "start": "NODE_ENV=production electron .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "electron": "^28.2.0",
    "plyr": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.14",
    "video.js": "^8.23.4",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
